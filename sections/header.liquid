{%- liquid
  assign has_catalogue = false
  for link in section.settings.menu.links
    if link.url == routes.all_products_collection_url
      assign has_catalogue = true
    endif
  endfor
-%}
{%- assign brand = settings.brand_name | default: shop.name -%}
<header class="site-header" data-header>
  <div class="site-header__inner page-width">
    <button type="button" class="site-header__icon site-header__menu-toggle" aria-controls="MobileMenu" aria-expanded="false" data-menu-open>
      {% render 'icon', name: 'menu' %}
      <span class="visually-hidden">{{ 'general.menu' | t }}</span>
    </button>

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: brand, height: section.settings.logo_height, style: 'height: var(--logo-height); width: auto;' }}
      {%- else -%}
        {{ settings.brand_name | default: shop.name }}
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="{{ 'general.menu' | t }}">
      <ul>
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__icons">
      <a class="site-header__icon site-header__search" href="{{ routes.all_products_collection_url }}#search">
        {% render 'icon', name: 'search' %}
        <span class="visually-hidden">{{ 'general.search' | t }}</span>
      </a>
      <a class="site-header__icon site-header__cart" href="{{ routes.cart_url }}">
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">{{ 'general.cart' | t }}</span>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="mobile-menu" id="MobileMenu" data-menu hidden>
    <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
      <div class="mobile-menu__top">
        <span class="mobile-menu__brand">{{ settings.brand_name | default: shop.name }}</span>
        <button type="button" class="site-header__icon" data-menu-close>
          {% render 'icon', name: 'close' %}
          <span class="visually-hidden">{{ 'general.close' | t }}</span>
        </button>
      </div>
      <ul class="mobile-menu__links">
        {%- for link in section.settings.menu.links -%}
          <li style="--i: {{ forloop.index }}"><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
        {%- unless has_catalogue -%}
          <li style="--i: {{ section.settings.menu.links.size | plus: 1 }}"><a href="{{ routes.all_products_collection_url }}">{{ 'general.catalogue' | t }}</a></li>
        {%- endunless -%}
      </ul>
      <p class="mobile-menu__note">✦ {{ section.settings.menu_note }}</p>
    </div>
  </div>
</header>

<style>
  .site-header { --logo-height: {{ section.settings.logo_height }}px; }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 36 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "menu_note", "label": "Mobile menu note", "default": "Wishing you a beautiful new year at home." }
  ]
}
{% endschema %}

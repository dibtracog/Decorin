<header class="site-header page-width">
  <a class="site-header__logo" href="{{ routes.root_url }}">
    {%- if section.settings.logo -%}
      {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name, height: 40 }}
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </a>

  <nav class="site-header__nav">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  </nav>

  <div class="site-header__icons">
    <a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
    <a href="{{ routes.cart_url }}">{{ 'general.cart' | t }} ({{ cart.item_count }})</a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}

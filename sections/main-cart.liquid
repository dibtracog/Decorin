<section class="cart-page page-width" data-cart-section="{{ section.id }}" data-change-url="{{ routes.cart_change_url }}" data-error-text="{{ 'cart.error' | t | escape }}">
  <div class="cart-page__head">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="cart-page__title">
        {{ 'cart.title' | t }}
        {%- if cart.item_count > 0 -%}
          <span class="cart-page__count">{{ 'cart.item_count' | t: count: cart.item_count }}</span>
        {%- endif -%}
      </h1>
    </div>
    {%- if cart.item_count > 0 -%}
      <a class="cart-page__continue" href="{{ routes.all_products_collection_url }}">
        {% render 'icon', name: 'arrow-left' %}{{ 'cart.continue_shopping' | t }}
      </a>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-layout" id="CartForm-{{ section.id }}" novalidate>
      <div class="cart-items-wrap">
        <div class="cart-items__labels" aria-hidden="true">
          <span>{{ 'cart.product' | t }}</span>
          <span>{{ 'products.quantity' | t }}</span>
          <span>{{ 'cart.total' | t }}</span>
        </div>

        <ul class="cart-items" role="list">
          {%- for item in cart.items -%}
            <li class="cart-item" data-cart-line="{{ forloop.index }}">
              <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '120px', alt: '' }}
                {%- else -%}
                  {% render 'placeholder-decor', index: forloop.index, class: 'cart-item__placeholder' %}
                {%- endif -%}
              </a>

              <div class="cart-item__info">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- unless property.last == blank or property.first contains '_' -%}
                    <p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>
                  {%- endunless -%}
                {%- endfor -%}
                <p class="cart-item__price">
                  {{ item.final_price | money }}
                  {%- if item.original_price > item.final_price -%}
                    <s>{{ item.original_price | money }}</s>
                  {%- endif -%}
                </p>
                {%- for discount in item.line_level_discount_allocations -%}
                  <p class="cart-item__discount">✦ {{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
                {%- endfor -%}
              </div>

              <div class="cart-item__controls">
                <div class="qty" data-qty>
                  <button type="button" class="qty__btn" data-qty-change="-1" aria-label="{{ 'cart.decrease' | t: product: item.product.title | escape }}">
                    {% render 'icon', name: 'minus' %}
                  </button>
                  <input class="qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric"
                    aria-label="{{ 'cart.quantity_for' | t: product: item.product.title | escape }}" data-qty-input>
                  <button type="button" class="qty__btn" data-qty-change="1" aria-label="{{ 'cart.increase' | t: product: item.product.title | escape }}">
                    {% render 'icon', name: 'plus' %}
                  </button>
                </div>
                <a class="cart-item__remove" href="{{ item.url_to_remove }}" data-cart-remove>
                  {% render 'icon', name: 'trash' %}
                  <span>{{ 'cart.remove' | t }}</span>
                  <span class="visually-hidden">{{ item.product.title }}</span>
                </a>
              </div>

              <p class="cart-item__total">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>
        <p class="cart-error" role="alert" data-cart-error hidden></p>
      </div>

      <aside class="cart-summary">
        <h2 class="cart-summary__title">{{ 'cart.summary' | t }}</h2>
        <dl class="cart-summary__rows">
          <div class="cart-summary__row">
            <dt>{{ 'cart.subtotal' | t }}</dt>
            <dd>{{ cart.items_subtotal_price | money }}</dd>
          </div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-summary__row cart-summary__row--discount">
              <dt>{{ discount.title }}</dt>
              <dd>−{{ discount.total_allocated_amount | money }}</dd>
            </div>
          {%- endfor -%}
          <div class="cart-summary__row">
            <dt>{{ 'cart.shipping' | t }}</dt>
            <dd class="cart-summary__free">{{ 'cart.free' | t }}</dd>
          </div>
          <div class="cart-summary__row cart-summary__row--total">
            <dt>{{ 'cart.estimated_total' | t }}</dt>
            <dd>{{ cart.total_price | money_with_currency }}</dd>
          </div>
        </dl>

        {%- if section.settings.use_upi_page -%}
          {%- assign payment_url = routes.cart_url | append: '?view=payment' -%}
          {%- if section.settings.payment_page != blank -%}{%- assign payment_url = section.settings.payment_page.url -%}{%- endif -%}
          <a class="button button--gold button--full cart-summary__checkout" href="{{ payment_url }}">
            {% render 'icon', name: 'lock' %}{{ 'cart.checkout' | t }}
          </a>
        {%- else -%}
          <button type="submit" name="checkout" class="button button--gold button--full cart-summary__checkout">
            {% render 'icon', name: 'lock' %}{{ 'cart.checkout' | t }}
          </button>
        {%- endif -%}
        <noscript>
          <button type="submit" name="update" class="button button--secondary button--full">{{ 'cart.update' | t }}</button>
        </noscript>
      </aside>
    </form>
  {%- else -%}
    <div class="cart-empty">
      <div class="cart-empty__art gradient-card gradient-card--1">
        {% render 'icon', name: 'cart' %}
      </div>
      <h2 class="cart-empty__title">{{ 'cart.empty' | t }}</h2>
      <p class="cart-empty__text">{{ section.settings.empty_text }}</p>
      <a class="button button--dark" href="{{ routes.all_products_collection_url }}">
        {{ 'cart.start_shopping' | t }}{% render 'icon', name: 'arrow-right' %}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Almost yours" },
    { "type": "checkbox", "id": "use_upi_page", "label": "Send checkout to the UPI payment page", "default": true, "info": "Turn off to use Shopify's standard checkout instead." },
    { "type": "page", "id": "payment_page", "label": "UPI payment page", "info": "Optional. Leave empty to use the built-in payment page (/cart?view=payment)." },
    { "type": "textarea", "id": "empty_text", "label": "Empty cart message", "default": "This new year, find something that makes your home feel brand new." }
  ]
}
{% endschema %}

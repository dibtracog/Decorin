<section class="ny-banner">
  <div class="page-width">
    <div class="ny-banner__inner">
      {% render 'starfield', count: 24 %}
      <div class="ny-banner__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="ny-banner__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="ny-banner__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <a class="button button--gold" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Year banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New year, new corners" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start the year in a home that feels brand new." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Small changes, big difference. Discover decor that turns resolutions into rooms you love." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore everything" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "New Year banner" }]
}
{% endschema %}

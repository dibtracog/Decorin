<section class="product page-width">
  <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    <span aria-hidden="true">/</span>
    <a href="{{ routes.all_products_collection_url }}">{{ 'general.catalogue' | t }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="product__grid">
    <div class="product__media">
      {%- for media in product.media -%}
        <div class="product__media-item">
          {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '500, 800, 1100, 1400' }}
        </div>
      {%- else -%}
        <div class="product__media-item">{% render 'placeholder-decor', index: 2, class: 'product__placeholder' %}</div>
      {%- endfor -%}
    </div>

    <div class="product__info">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="product__title">{{ product.title }}</h1>
      {% render 'review-summary', product: product %}
      <p class="product__price">
        {{ product.selected_or_first_available_variant.price | money }}
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          <s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>
        {%- endif -%}
      </p>

      {%- form 'product', product, class: 'product__form' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- else -%}
          <div class="field">
            <label for="Variant-{{ section.id }}">{{ 'products.variant' | t }}</label>
            <select id="Variant-{{ section.id }}" name="id">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"
                  {%- if variant == product.selected_or_first_available_variant %} selected{% endif -%}
                  {%- unless variant.available %} disabled{% endunless -%}>
                  {{ variant.title }} – {{ variant.price | money }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <div class="field">
          <label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
          <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
        </div>

        <button type="submit" class="button button--dark button--full" {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </button>
      {%- endform -%}

      <div class="product__description rte">{{ product.description }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Year Collection" }
  ]
}
{% endschema %}

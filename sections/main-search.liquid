<section class="search">
  <h1>{{ 'general.search' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}" aria-label="{{ 'general.search' | t }}">
    <button type="submit" class="button">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 12 -%}
      <p>{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <div><a href="{{ item.url }}"><h3>{{ item.title }}</h3></a></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {{ paginate | default_pagination }}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}

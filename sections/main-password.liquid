<section class="password">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <label for="Password">{{ 'password.label' | t }}</label>
    <input type="password" name="password" id="Password" autocomplete="current-password">
    <button type="submit" class="button">{{ 'password.enter' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}

{%- comment -%}
  Contact page: WhatsApp + email cards (blocks), hours/delivery notes and Shopify's contact form.
  Used by templates/page.contact.json (the "Contact" page in Online Store > Pages).
{%- endcomment -%}
{%- liquid
  assign city = settings.area_city | default: 'Jaipur'
  assign area_state = settings.area_state | default: 'Rajasthan'
-%}
<section class="contact page-width" id="ContactPage-{{ section.id }}">
  <header class="contact__hero">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="contact__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="contact__lead">{{ section.settings.text }}</p>{%- endif -%}
  </header>

  <ul class="contact__cards" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign digits = block.settings.number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
        if block.type == 'whatsapp'
          assign message = block.settings.message | url_encode
          assign href = 'https://wa.me/' | append: digits | append: '?text=' | append: message
          assign shown = block.settings.number
          assign icon = 'whatsapp'
          assign action = 'contact.whatsapp_action' | t
        else
          assign href = 'mailto:' | append: block.settings.email
          assign shown = block.settings.email
          assign icon = 'mail'
          assign action = 'contact.email_action' | t
        endif
      -%}
      <li class="contact-card contact-card--{{ block.type }}" {{ block.shopify_attributes }}>
        <a class="contact-card__link" href="{{ href }}" {% if block.type == 'whatsapp' %}target="_blank" rel="noopener"{% endif %}>
          <span class="contact-card__icon">{% render 'icon', name: icon %}</span>
          <span class="contact-card__body">
            <span class="contact-card__kind">{{ block.settings.label }}</span>
            <span class="contact-card__name">{{ block.settings.name }}</span>
            <span class="contact-card__value">{{ shown }}</span>
          </span>
          <span class="contact-card__action">{{ action }}{% render 'icon', name: 'arrow-right' %}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>

  <div class="contact__social">{%- render 'instagram-bubble' -%}</div>

  <div class="contact__lower">
    <aside class="contact__info gradient-card">
      {%- render 'starfield', count: 14 -%}
      <h2 class="contact__info-title">{{ 'contact.info_title' | t }}</h2>
      <ul class="contact__facts" role="list">
        <li>{% render 'icon', name: 'clock' %}<span>{{ section.settings.hours }}</span></li>
        <li>{% render 'icon', name: 'pin' %}<span>{{ 'area.footer' | t: city: city, state: area_state }}</span></li>
        <li>{% render 'icon', name: 'truck' %}<span>{{ section.settings.orders_note }}</span></li>
      </ul>
    </aside>

    <div class="contact__form-wrap">
      <h2 class="contact__form-title">{{ 'contact.form_title' | t }}</h2>
      {%- form 'contact', class: 'contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact__success" role="status">{% render 'icon', name: 'check' %}{{ 'contact.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}<div class="contact__errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="contact__row">
            <div class="field">
              <label for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
              <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
              <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
            </div>
          </div>
          <div class="field">
            <label for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
            <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" placeholder="98765 43210">
          </div>
          <div class="field">
            <label for="ContactMessage-{{ section.id }}">{{ 'contact.message' | t }}</label>
            <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="5" required></textarea>
          </div>
          <button type="submit" class="button button--dark">{{ 'contact.send' | t }}{% render 'icon', name: 'arrow-right' %}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We'd love to hear from you" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions about a product, your order or a custom request? Message us on WhatsApp for the quickest reply, or drop us an email." },
    { "type": "text", "id": "hours", "label": "Reply hours", "default": "We usually reply within a few hours, 10 am – 9 pm, every day." },
    { "type": "text", "id": "orders_note", "label": "Orders note", "default": "For an order, keep your order number handy, and we'll sort it out quickly." }
  ],
  "blocks": [
    {
      "type": "whatsapp",
      "name": "WhatsApp",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "WhatsApp" },
        { "type": "text", "id": "name", "label": "Name", "default": "Chat with us" },
        { "type": "text", "id": "number", "label": "Number (with country code)", "default": "+91 98765 43210" },
        { "type": "text", "id": "message", "label": "Pre-filled message", "default": "Hi DecorIn! I have a question." }
      ]
    },
    {
      "type": "email",
      "name": "Email",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "text", "id": "name", "label": "Name", "default": "Write to us" },
        { "type": "text", "id": "email", "label": "Email address", "default": "hello@example.com" }
      ]
    }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}

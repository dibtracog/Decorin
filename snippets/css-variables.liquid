{%- comment -%} Exposes theme settings (config/settings_schema.json) as CSS variables and loads fonts. {%- endcomment -%}
{%- liquid
  assign heading_font = settings.type_heading_font
  assign heading_italic = heading_font | font_modify: 'style', 'italic'
  assign body_font = settings.type_body_font
  assign body_bold = body_font | font_modify: 'weight', 'bold'
-%}
<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_italic | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}

  :root {
    --c-midnight: {{ settings.color_midnight }};
    --c-midnight-deep: {{ settings.color_midnight | color_darken: 6 }};
    --c-midnight-soft: {{ settings.color_midnight | color_lighten: 8 }};
    --c-gold: {{ settings.color_gold }};
    --c-gold-light: {{ settings.color_gold | color_lighten: 18 }};
    --c-gold-dark: {{ settings.color_gold | color_darken: 18 }};
    --c-ivory: {{ settings.color_ivory }};
    --c-text: {{ settings.color_text }};
    --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --page-width: {{ settings.page_width }}px;
  }
</style>

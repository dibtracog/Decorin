{%- comment -%}
  Line-art illustrations for the feature cards.
  Usage: {% render 'feature-art', name: 'gift', uid: block.id %}
  Names: sparkle (caring hands), gift, truck (front-door delivery), shield (secure checkout), leaf, heart
{%- endcomment -%}
<svg class="feature__art" viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="FeatureGlow-{{ uid }}">
      <stop offset="0" stop-color="currentColor" stop-opacity=".24"/>
      <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <g class="fa">
    {%- case name -%}
      {%- when 'gift' -%}
        <circle cx="78" cy="90" r="42" fill="url(#FeatureGlow-{{ uid }})" stroke="none"/>

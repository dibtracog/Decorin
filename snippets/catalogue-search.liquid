{%- comment -%}
  Catalogue search box with live results.
  Usage: {% render 'catalogue-search', terms: search.terms %}
  Must sit outside the [data-results] container so typing never loses focus.
{%- endcomment -%}
<form class="facets__search" action="{{ routes.search_url }}" method="get" role="search" data-facets-search data-live-search data-catalogue-url="{{ routes.all_products_collection_url }}"{% if terms != blank %} data-has-results{% endif %}>
  <input type="hidden" name="type" value="product">
  <input type="hidden" name="options[prefix]" value="last">
  <label class="visually-hidden" for="CatalogueSearch">{{ 'facets.search_label' | t }}</label>
  <span class="facets__search-progress" aria-hidden="true"></span>
  <span class="facets__search-icon">{% render 'icon', name: 'search' %}</span>
  <input class="facets__search-input" type="search" id="CatalogueSearch" name="q" value="{{ terms | escape }}" placeholder="{{ 'facets.search_placeholder' | t }}" autocomplete="off" data-search-input>
  <button class="facets__search-clear" type="button" data-search-clear>
    {% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'facets.clear_search' | t }}</span>
  </button>
  <button class="facets__search-submit" type="submit">{{ 'general.search' | t }}</button>
</form>
